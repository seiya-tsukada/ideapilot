{
  "name": "ideapilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
